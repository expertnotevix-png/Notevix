# GEMINI_API_KEY: Required for Gemini AI API calls.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Optional, for using NVIDIA-hosted models.
VITE_NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# UPI_ID: The UPI ID for payments.
VITE_UPI_ID="9236489649@mbk"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WEBHOOK_SECRET: Secret token for automated payment verification.
WEBHOOK_SECRET="change_me_to_a_secure_random_string"

# Admin Diagnostics debug mode (true/false)
VITE_ADMIN_DEBUG_MODE=false
